# Hummingbot Backend API - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# API Authentication
# =============================================================================
# Credentials for HTTP Basic Auth to access the API endpoints
API_USERNAME=admin
API_PASSWORD=your_secure_password_here

# Set to true to disable authentication (development only)
DEBUG_MODE=false

# =============================================================================
# MQTT Broker (EMQX)
# =============================================================================
# Connection settings for the MQTT broker used for bot communication
BROKER_HOST=localhost
BROKER_PORT=1883
BROKER_USERNAME=admin
BROKER_PASSWORD=public

# =============================================================================
# Hummingbot Configuration
# =============================================================================
# Password for encrypting Hummingbot configuration files
CONFIG_PASSWORD=changeme

# Comma-separated list of tokens to exclude from trading
BANNED_TOKENS=NAV,ARS,ETHW,ETHF

# =============================================================================
# AWS S3 (Optional - for bot archiving)
# =============================================================================
# AWS credentials for archiving bot instances to S3
# AWS_API_KEY=your_aws_access_key
# AWS_SECRET_KEY=your_aws_secret_key
# AWS_BUCKET_NAME=your-bucket-name
